{
    "name": "easypixels/sdk-php",
    "description": "PHP SDK for EasyPixel LED matrix management API",
    "type": "library",
    "license": "MIT",
    "keywords": ["easypixel", "led", "matrix", "pixel", "api", "sdk", "webhook"],
    "homepage": "https://github.com/easypixels/sdk-php",
    "require": {
        "php": ">=7.2",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.5 || ^9.6 || ^10.5 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "EasyPixel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EasyPixel\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
